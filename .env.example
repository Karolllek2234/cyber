# Shop reverse proxy (nginx). Use a port >= 1024 for rootless / userspace Docker.
SHOP_HTTP_PORT=8080

# Seconds between user browse loops (not a startup delay).
USER_REQUEST_INTERVAL_SECONDS=5

# Delay before the user container starts generating traffic (seconds).
SIMULATED_TRAFFIC_USER=0

# Delay before the attacker starts the ZAP daemon (seconds).
SIMULATED_TRAFFIC_ATTACKER=60

# Delay after ZAP is ready before the simulated attack runs (seconds).
SIMULATED_TRAFFIC_ATTACKER_DELAY=60

# Run the ZAP scan automatically when the attacker is ready (true/false).
SIMULATED_TRAFFIC_TRIGGER=false
